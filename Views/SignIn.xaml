<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.SignIn"
                          Title="SignIn"

             
             xmlns:Views="clr-namespace:MauiApp2.Views"
             x:DataType="Views:SignIn"
             FlowDirection="RightToLeft">
                

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="#3a7bd5"/>
            <GradientStop Offset="1.0" Color="Purple"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">
        <Label
            FontAttributes="Bold"
            FontSize="25"
            VerticalOptions="Center"
            Text="כניסה"
            TextColor="Snow"/>
        <Border
            Padding="10"
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Entry
                Text="{Binding UserName}"
                Keyboard="Email"
                FontSize="18"
                Placeholder="Email"
                TextColor="Wheat"
                ReturnType="Go">
            </Entry>
        </Border>
        <Border
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Grid
                Padding="10"
                ColumnDefinitions="*,Auto"
                VerticalOptions="Center">
                <Entry
                    Text="{Binding UserPassword}"
                    BackgroundColor="Transparent"
                    IsPassword="{Binding EntryAsPassword}"
                    FontSize="18"
                    Placeholder="סיסמה"
                    TextColor="Wheat"
                    VerticalOptions="Center"/>
                                <Button
                    x:Name="TogglePassordButton"
                   
                    Margin="5,0,0,0"
                    Padding="0"
                    BackgroundColor="Transparent"
                    FontFamily="MaterialIcons-Regular"
                    FontSize="24"
                    HorizontalOptions="End"
                    Text="&#xe8f4;"
                    TextColor="White"
                    VerticalOptions="Center"/>
            </Grid>
        </Border>
        <Button
            CornerRadius="8"
            FontSize="18"
            HeightRequest="50"
            IsEnabled="{Binding IsSignedInButtonEnabled}"
            Text="חיבור"
            TextColor="White"
            Clicked="OnSignInButtonClicked"/>
        <Label
            x:Name="errorLbl"
            FontSize="45"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            Text="שגיאה"
            TextColor="Red"/>
    </VerticalStackLayout>
</ContentPage>